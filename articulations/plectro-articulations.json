{
  "name": "Plectro",
  "vendor": "Do2tis",
  "version": 1,
  "description": "Single source of truth for Plectro's articulation keyswitch map. Edit this file, then run tools/generate_articulation_maps.py to regenerate every derived artifact (C++ header, host expression/articulation maps, docs). Never hand-edit the generated files.",
  "keyswitchZone": {
    "base": 0,
    "top": 12,
    "note": "Reserved low MIDI zone (C-1..C0). No plucked-string instrument plays that low, and it matches MuseScore's own reserved keyswitch zone. The MIDI number is the reference; hosts label it C-2, C-1 or C0 depending on their octave convention."
  },
  "behaviors": {
    "Latching": "Selected by a single Note On and held until another keyswitch changes it. No Note Off. The primary articulations.",
    "Momentary": "Active only while the keyswitch is held (Note On..Note Off). Reserved for future use; Plectro ships none today.",
    "Span": "Held across a range of notes (Note On at the range start, Note Off at the range end). Reserved for future range techniques.",
    "Modifier": "Layers over the current timbre instead of replacing it, held between Note On and Note Off. Legato is the only modifier today."
  },
